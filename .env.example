# ==============================================================
# BILINGUAL LEGAL CONTRACT GENERATOR - ENVIRONMENT VARIABLES
# ==============================================================
# Copy this file to .env and fill in your real values.
# نسخ هذا الملف إلى .env وأدخل القيم الحقيقية.
# ==============================================================

# Required: Google Gemini API Key from Google AI Studio
# https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Preferred Gemini Model
# GEMINI_MODEL=gemini-2.5-flash

# ==============================================================
# PAYPAL PAYMENT GATEWAY CONFIGURATION
# ==============================================================
# Get credentials from: https://developer.paypal.com/dashboard/applications
VITE_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal Environment: 'live' for real payments, 'sandbox' for testing
PAYPAL_MODE=sandbox
